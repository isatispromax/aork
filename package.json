{
  "name": "aork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "plugin:build": "node scripts/plugin-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && NODE_OPTIONS=--max-old-space-size=8192 vitest run --maxWorkers=2",
    "test:browser": "pnpm build && playwright test",
    "start": "node dist/server/main.mjs",
    "aork": "node dist/server/main.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@aork/contracts": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.58.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@aork/sdk": "workspace:*",
    "@aork/ui": "workspace:*",
    "better-sqlite3": "12.6.2",
    "fs-ext": "2.1.1"
  }
}
