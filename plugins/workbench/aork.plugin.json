{
  "manifestVersion": 1,
  "id": "workbench",
  "version": "0.1.0",
  "sdkRange": "~0.1.0",
  "server": "server.js",
  "client": "client.js",
  "assets": [
    "client.css"
  ],
  "requires": [],
  "optionalRequires": [
    "aork.sessions@1"
  ],
  "provides": [
    "aork.workbench@1"
  ],
  "capabilities": [],
  "ui": {
    "providers": [
      {
        "id": "layout",
        "contract": "aork.workbench.layout@1"
      },
      {
        "id": "home",
        "contract": "aork.workbench.home@1"
      },
      {
        "id": "theme",
        "contract": "aork.ui.theme@1"
      },
      {
        "id": "icons",
        "contract": "aork.ui.icons@1"
      },
      {
        "id": "settings",
        "contract": "aork.settings@1"
      },
      {
        "id": "sidebar",
        "contract": "aork.workbench.sidebar@1"
      },
      {
        "id": "header",
        "contract": "aork.workbench.header-view@1"
      },
      {
        "id": "main",
        "contract": "aork.workbench.main@1"
      },
      {
        "id": "inspector",
        "contract": "aork.workbench.inspector@1"
      },
      {
        "id": "menu",
        "contract": "aork.workbench.menu@1"
      },
      {
        "id": "notifications",
        "contract": "aork.workbench.notifications@1"
      },
      {
        "id": "pending",
        "contract": "aork.workbench.pending@1"
      },
      {
        "id": "unread",
        "contract": "aork.workbench.unread@1"
      },
      {
        "id": "read-tracker",
        "contract": "aork.workbench.read-tracker@1"
      }
    ],
    "extensions": [
      {
        "id": "pending-link",
        "target": "aork.workbench.navigation@1",
        "order": 10
      },
      {
        "id": "new-session",
        "target": "aork.workbench.navigation@1",
        "order": 0
      },
      {
        "id": "menu-pending",
        "target": "aork.workbench.menu-items@1",
        "order": 20
      },
      {
        "id": "menu-unread",
        "target": "aork.workbench.menu-items@1",
        "order": 30
      },
      {
        "id": "unread-indicator",
        "target": "aork.workbench.notification-sources@1",
        "order": 0
      }
    ]
  }
}
