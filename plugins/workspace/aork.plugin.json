{
  "manifestVersion": 1,
  "id": "workspace",
  "version": "0.1.0",
  "sdkRange": "^0.1.0",
  "server": "server.js",
  "client": "client.js",
  "assets": [
    "client.css"
  ],
  "requires": [],
  "provides": [
    "aork.workspace@1",
    "aork.workspace.run-files@1"
  ],
  "capabilities": [
    "filesystem.read",
    "filesystem.write"
  ],
  "ui": {
    "providers": [
      {
        "id": "files",
        "contract": "aork.workspace.files@1"
      },
      {
        "id": "navigation",
        "contract": "aork.workspace.navigation@1"
      },
      {
        "id": "page",
        "contract": "aork.workspace.page@1"
      },
      {
        "id": "directory-picker",
        "contract": "aork.workspace.directory-picker@1"
      }
    ],
    "extensions": [
      {
        "id": "files-section",
        "target": "aork.workbench.inspector-tabs@1",
        "order": 10,
        "label": "文件",
        "icon": "files",
        "description": "浏览、搜索、预览与编辑工作区文件",
        "opensWith": "file"
      }
    ]
  }
}
