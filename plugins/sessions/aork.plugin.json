{
  "manifestVersion": 1,
  "id": "sessions",
  "version": "0.1.0",
  "sdkRange": "^0.1.0",
  "server": "server.js",
  "client": "client.js",
  "requires": [
    "aork.workspace@1",
    "aork.agent.profiles@1",
    "aork.agent.providers@1",
    "aork.tools@1"
  ],
  "provides": [
    "aork.sessions@1"
  ],
  "capabilities": [],
  "ui": {
    "providers": [
      {
        "id": "navigation",
        "contract": "aork.sessions.navigation@1"
      },
      {
        "id": "create",
        "contract": "aork.sessions.create@1"
      },
      {
        "id": "detail",
        "contract": "aork.sessions.detail@1"
      },
      {
        "id": "composer",
        "contract": "aork.sessions.composer@1"
      },
      {
        "id": "messages",
        "contract": "aork.sessions.messages@1"
      },
      {
        "id": "tools",
        "contract": "aork.sessions.tools@1"
      },
      {
        "id": "input-options",
        "contract": "aork.sessions.input-options@1"
      },
      {
        "id": "header",
        "contract": "aork.sessions.header@1"
      },
      {
        "id": "actions",
        "contract": "aork.sessions.actions@1"
      },
      {
        "id": "recovery",
        "contract": "aork.sessions.recovery@1"
      },
      {
        "id": "native-history",
        "contract": "aork.sessions.native-history@1"
      }
    ],
    "extensions": [
      {
        "id": "menu-actions",
        "target": "aork.workbench.menu-items@1",
        "order": 10
      }
    ]
  },
  "assets": [
    "client.css"
  ],
  "optionalRequires": [
    "aork.runtime.acp@1",
    "aork.interactions@1",
    "aork.runtime.reconciliation@1"
  ]
}
