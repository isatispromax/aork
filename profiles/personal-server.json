{
  "schemaVersion": 1,
  "id": "personal-server",
  "plugins": [
    {
      "id": "auth-single-user",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "workbench",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "workspace",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "plugin-diagnostics",
      "version": "0.1.0",
      "enabled": true,
      "grants": [
        "diagnostics.read"
      ]
    }
  ],
  "ui": {
    "providers": {
      "aork.auth.login@1": "auth-single-user:login",
      "aork.workbench.layout@1": "workbench:layout",
      "aork.workbench.home@1": "workbench:home",
      "aork.ui.theme@1": "workbench:theme",
      "aork.ui.icons@1": "workbench:icons",
      "aork.auth.controls@1": "auth-single-user:controls",
      "aork.plugins.diagnostics@1": "plugin-diagnostics:diagnostics",
      "aork.workspace.browser@1": "workspace:browser"
    },
    "extensions": []
  }
}
