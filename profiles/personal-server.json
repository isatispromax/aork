{
  "schemaVersion": 1,
  "id": "personal-server",
  "plugins": [
    {
      "id": "auth-single-user",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "workbench",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "workspace",
      "version": "0.1.0",
      "enabled": true,
      "grants": [
        "filesystem.read",
        "filesystem.write"
      ]
    },
    {
      "id": "plugin-diagnostics",
      "version": "0.1.0",
      "enabled": true,
      "grants": [
        "diagnostics.read"
      ]
    },
    {
      "id": "plugin-management",
      "version": "0.1.0",
      "enabled": true,
      "grants": [
        "plugins.manage"
      ]
    },
    {
      "id": "agent-profiles",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "sessions",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "runner-local",
      "version": "0.1.0",
      "enabled": true,
      "grants": [
        "process.spawn"
      ]
    },
    {
      "id": "runtime-acp",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "interactions",
      "version": "0.1.0",
      "enabled": true
    },
    {
      "id": "artifacts",
      "version": "0.1.0",
      "enabled": true,
      "grants": [
        "filesystem.read",
        "filesystem.write"
      ]
    }
  ],
  "ui": {
    "providers": {
      "aork.auth.login@1": "auth-single-user:login",
      "aork.workbench.layout@1": "workbench:layout",
      "aork.workbench.home@1": "workbench:home",
      "aork.ui.theme@1": "workbench:theme",
      "aork.ui.icons@1": "workbench:icons",
      "aork.auth.controls@1": "auth-single-user:controls",
      "aork.plugins.diagnostics@1": "plugin-diagnostics:diagnostics",
      "aork.workspace.browser@1": "workspace:browser",
      "aork.plugins.management@1": "plugin-management:management",
      "aork.settings@1": "workbench:settings",
      "aork.workspace.files@1": "workspace:files",
      "aork.sessions.navigation@1": "sessions:navigation",
      "aork.sessions.create@1": "sessions:create",
      "aork.sessions.detail@1": "sessions:detail",
      "aork.sessions.composer@1": "sessions:composer",
      "aork.sessions.messages@1": "sessions:messages",
      "aork.sessions.tools@1": "sessions:tools",
      "aork.interactions.cards@1": "interactions:cards",
      "aork.interactions.permission@1": "interactions:permission",
      "aork.interactions.input-cards@1": "interactions:input-cards",
      "aork.interactions.form@1": "interactions:form",
      "aork.sessions.input-options@1": "sessions:input-options",
      "aork.workbench.sidebar@1": "workbench:sidebar",
      "aork.workbench.header-view@1": "workbench:header",
      "aork.workbench.main@1": "workbench:main",
      "aork.workbench.menu@1": "workbench:menu",
      "aork.workbench.notifications@1": "workbench:notifications",
      "aork.workbench.pending@1": "workbench:pending",
      "aork.workbench.unread@1": "workbench:unread",
      "aork.workbench.read-tracker@1": "workbench:read-tracker",
      "aork.workspace.navigation@1": "workspace:navigation",
      "aork.workspace.page@1": "workspace:page",
      "aork.sessions.header@1": "sessions:header",
      "aork.workspace.project-page@1": "workspace:project-page",
      "aork.workspace.workspace-page@1": "workspace:workspace-page",
      "aork.sessions.actions@1": "sessions:actions",
      "aork.sessions.recovery@1": "sessions:recovery",
      "aork.sessions.native-history@1": "sessions:native-history",
      "aork.artifacts.registration@1": "artifacts:registration",
      "aork.artifacts.list@1": "artifacts:list",
      "aork.artifacts.versions@1": "artifacts:versions",
      "aork.artifacts.preview@1": "artifacts:preview"
    },
    "extensions": [],
    "renderers": {
      "text/html": "artifacts:html"
    }
  }
}
